{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        "public": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['username', 'usernameLower', 'displayName'])"
        },
        "ai_persona": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.child('enabled').isBoolean() && newData.child('prompt').isString()"
        },
        "presence": {
          ".read": "auth != null",
          "connections": {
            "$connectionId": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.val() === true"
            }
          },
          "lastChanged": {
            ".write": "auth != null && auth.uid === $uid"
          },
          "status": {
            ".write": "auth != null && auth.uid === $uid"
          },
          "statusText": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "usernameIndex": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.isString()",
        ".validate": "newData.val() === auth.uid"
      }
    },
    "servers": {
      ".read": "auth != null",
      "$serverId": {
        ".write": "auth != null && (!data.exists() || data.child('ownerId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['name', 'ownerId', 'createdAt'])"
      }
    },
    "serverMembers": {
      "$serverId": {
        ".read": "auth != null && data.child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('serverMembers').child($serverId).child(auth.uid).child('role').val() === 'owner' || root.child('serverMembers').child($serverId).child(auth.uid).child('role').val() === 'admin')",
          ".validate": "newData.hasChildren(['role', 'joinedAt'])"
        }
      }
    },
    "categories": {
      "$serverId": {
        ".read": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()",
        "$categoryId": {
          ".write": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['name', 'position'])"
        }
      }
    },
    "channels": {
      "$serverId": {
        ".read": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()",
        "$channelId": {
          ".write": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['name', 'type', 'position'])"
        }
      }
    },
    "serverRoles": {
      "$serverId": {
        ".read": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()",
        "$roleId": {
          ".write": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()"
        }
      }
    },
    "invites": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['serverId', 'createdBy', 'createdAt'])"
      }
    },
    "messages": {
      "$serverId": {
        "$channelId": {
          ".read": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()",
          "$messageId": {
            ".write": "auth != null && ( !data.exists() && newData.child('authorId').val() === auth.uid || data.exists() && (data.child('authorId').val() === auth.uid || root.child('serverMembers').child($serverId).child(auth.uid).child('role').val() === 'owner'))",
            ".validate": "newData.hasChildren(['authorId', 'content', 'createdAt']) && newData.child('serverId').val() === $serverId && newData.child('channelId').val() === $channelId"
          }
        }
      }
    },
    "attachments": {
      "$serverId": {
        "$channelId": {
          ".read": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()",
          "$messageId": {
            ".write": "auth != null && (!data.exists() && newData.child('authorId').val() === auth.uid || data.exists() && data.child('authorId').val() === auth.uid)",
            ".validate": "newData.hasChildren(['authorId', 'data'])"
          }
        }
      }
    },
    "reactions": {
      "$serverId": {
        "$channelId": {
          ".read": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()",
          "$messageId": {
            "$emoji": {
              ".write": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()"
            }
          }
        }
      }
    },
    "typing": {
      "$serverId": {
        "$channelId": {
          ".read": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['username', 'timestamp'])"
          }
        }
      }
    },
    "polls": {
      "$serverId": {
        "$channelId": {
          "$pollId": {
            ".read": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()",
            ".write": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()"
          }
        }
      }
    },
    "pollVotes": {
      "$pollId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "threads": {
      "$serverId": {
        "$channelId": {
          "$threadId": {
            ".read": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()",
            ".write": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()"
          }
        }
      }
    },
    "threadMessages": {
      "$threadId": {
        ".read": "auth != null",
        "$messageId": {
          ".write": "auth != null && !data.exists() && newData.child('authorId').val() === auth.uid",
          ".validate": "newData.hasChildren(['authorId', 'content', 'createdAt'])"
        }
      }
    },
    "pins": {
      "$serverId": {
        "$channelId": {
          "$messageId": {
            ".read": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()",
            ".write": "auth != null && root.child('serverMembers').child($serverId).child(auth.uid).exists()"
          }
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "friendRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$fromUid": {
          ".write": "auth != null && auth.uid === $fromUid"
        }
      }
    },
    "dmThreads": {
      ".read": "auth != null",
      "$threadId": {
        ".read": "auth != null && data.child('participants').child(auth.uid).exists()",
        ".write": "auth != null && newData.child('participants').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['participants', 'createdAt'])"
      }
    },
    "dmMessages": {
      "$threadId": {
        ".read": "auth != null && root.child('dmThreads').child($threadId).child('participants').child(auth.uid).exists()",
        "$messageId": {
          ".write": "auth != null && !data.exists() && newData.child('authorId').val() === auth.uid",
          ".validate": "newData.hasChildren(['authorId', 'content', 'createdAt'])"
        }
      }
    },
    "signaling": {
      "$channelId": {
        ".read": "auth != null && root.child('serverMembers').child(data.child('serverId').val()).child(auth.uid).exists()",
        ".write": "auth != null && !data.exists() && root.child('serverMembers').child(newData.child('serverId').val()).child(auth.uid).exists()",
        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('serverMembers').child(data.parent().parent().child('serverId').val()).child(auth.uid).exists()"
          }
        },
        "offers": {
          "$toUid": {
            "$fromUid": {
              ".write": "auth != null && auth.uid === $fromUid && root.child('serverMembers').child(data.parent().parent().parent().child('serverId').val()).child(auth.uid).exists()"
            }
          }
        },
        "answers": {
          "$toUid": {
            "$fromUid": {
              ".write": "auth != null && auth.uid === $fromUid && root.child('serverMembers').child(data.parent().parent().parent().child('serverId').val()).child(auth.uid).exists()"
            }
          }
        },
        "candidates": {
          "$fromUid": {
            "$toUid": {
              "$candidateId": {
                ".write": "auth != null && auth.uid === $fromUid && root.child('serverMembers').child(data.parent().parent().parent().parent().child('serverId').val()).child(auth.uid).exists()"
              }
            }
          }
        }
      }
    },
    "aiJobs": {
      ".read": false,
      ".write": false
    }
  }
}