# ── Server ──
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# Public URL used in logs/docs (no secret)
PUBLIC_WS_URL=ws://localhost:3001/ws
PUBLIC_HTTP_URL=http://localhost:3001

# ── CORS ──
CORS_ORIGIN=*

# ── Auth / Supabase ──
# Option A: Generic HMAC secret (HS256) – simplest for local dev
JWT_SECRET=change-me-super-secret-32chars
# Option B: Supabase – set SUPABASE_JWT_SECRET (same as JWT_SECRET for Supabase HS256)
# or if Supabase uses RS256 (new projects), leave SUPABASE_JWT_SECRET empty and set JWKS_URL
SUPABASE_JWT_SECRET=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# If Supabase project uses RS256, set to https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# (HS256 projects leave empty)
JWKS_URL=
JWT_AUDIENCE=authenticated
JWT_ISSUER=
# Token verification: "supabase" | "generic" | "dev-bypass" (dev-bypass allows unsigned tokens for testing)
AUTH_MODE=generic

# ── Rooms / SFU ──
MAX_ROOMS=1000
MAX_PARTICIPANTS_PER_ROOM=50
MAX_TRACKS_PER_PARTICIPANT=6
ROOM_IDLE_TIMEOUT_MS=300000
PARTICIPANT_STALE_TIMEOUT_MS=60000
RECONNECT_WINDOW_MS=60000
HEARTBEAT_INTERVAL_MS=25000

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_EVENTS=30
RATE_LIMIT_BURST=50
RATE_LIMIT_BAN_DURATION_MS=60000

# ── SFU ──
# "signaling" = pure signaling router (no media relay, mesh/SFU-ready abstraction)
# "mediasoup" = mediasoup worker (requires mediasoup installed & built)
SFU_MODE=signaling
MEDIASOUP_WORKER_BIN=
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=49999
MEDIASOUP_ANNOUNCED_IP=

# ── Observability ──
LOG_LEVEL=info
LOG_FORMAT=json
